{
  "mqtt": {
    "servers": [
      {
        "id": "home",
        "connectionType": "ws",
        "host": "localhost",
        "port": 9001,
        "broker": "ws://localhost:9001",
        "autoConnect": true
      },
      {
        "id": "home-wss",
        "connectionType": "wss",
        "host": "localhost",
        "port": 9002,
        "broker": "wss://localhost:9002",
        "autoConnect": true,
        "tls": {
          "caFile": "ca.crt",
          "certFile": "client.key",
          "keyFile": "client.key"
        }
      },
      {
        "id": "external-wss",
        "connectionType": "wss",
        "host": "10.8.123.100",
        "port": 8084,
        "broker": "wss://10.8.123.100:8084",
        "autoConnect": true,
        "basepath": "/mqtt",
        "username": "dev",
        "password": "dev",
        "tls": {
          "caFile": "ca.crt",
          "certFile": "client.crt",
          "keyFile": "client.key"
        }
      }
    ]
  },
  "actions": [
    {
      "id": "Focus Panel 1 Second",
      "type": "focus-panel",
      "description": "1 Second Focus",
      "icon": "mdi:fullscreen",
      "timeout": 1
    },
    {
      "id": "Focus Panel",
      "type": "focus-panel",
      "description": "Focus",
      "icon": "mdi:fullscreen",
      "timeout": 5,
      "trigger": {
        "mqttServer": "home",
        "topic": "home/living/lights/state",
        "payload": "ON"
      },
      "stream": "test-8"
    },
    {
      "id": "lights-on",
      "type": "mqtt",
      "description": "Lights On",
      "icon": "mdi:lightbulb",
      "mqttServer": "external-wss",
      "publish": {
        "topic": "home/living/lights/set",
        "payload": "ON"
      },
      "state": {
        "topic": "home/living/lights/state",
        "onValue": "ON"
      }
    },
    {
      "id": "lights-off",
      "type": "mqtt",
      "description": "Lights Off",
      "icon": "mdi:lightbulb-off",
      "mqttServer": "external-wss",
      "publish": {
        "topic": "home/living/lights/set",
        "payload": "OFF"
      },
      "state": {
        "topic": "home/living/lights/state",
        "onValue": "OFF"
      }
    },
    {
      "id": "fan-on",
      "type": "mqtt",
      "mqttServer": "home",
      "description": "Fan On",
      "icon": "mdi:fan",
      "publish": {
        "topic": "home/living/fan/set",
        "payload": "ON"
      },
      "state": {
        "topic": "home/living/fan/state",
        "onValue": "ON"
      }
    },
    {
      "id": "fan-off",
      "type": "mqtt",
      "mqttServer": "home",
      "description": "Fan Off",
      "icon": "mdi:fan-off",
      "publish": {
        "topic": "home/living/fan/set",
        "payload": "OFF"
      },
      "state": {
        "topic": "home/living/fan/state",
        "onValue": "OFF"
      }
    },
    {
      "id": "lock-door",
      "type": "mqtt",
      "description": "Lock",
      "icon": "mdi:lock",
      "mqttServer": "home",
      "publish": {
        "topic": "home/front-door/lock/set",
        "payload": "LOCK"
      },
      "state": {
        "topic": "home/front-door/lock/state",
        "onValue": "LOCKED"
      }
    },
    {
      "id": "unlock-door",
      "type": "mqtt",
      "description": "Unlock",
      "icon": "mdi:lock-open",
      "mqttServer": "home",
      "publish": {
        "topic": "home/front-door/lock/set",
        "payload": "UNLOCK"
      },
      "state": {
        "topic": "home/front-door/lock/state",
        "onValue": "UNLOCKED"
      }
    },
    {
      "id": "server-1-ping",
      "type": "mqtt",
      "description": "Server 1 Ping",
      "icon": "mdi:heart-pulse",
      "mqttServer": "external-wss",
      "publish": {
        "topic": "dev/server1/ping",
        "payload": "PING"
      },
      "state": {
        "topic": "dev/server1/status",
        "onValue": "PONG"
      }
    },
    {
      "id": "server-1-status",
      "type": "mqtt",
      "description": "Server 1 Status",
      "icon": "mdi:information-outline",
      "mqttServer": "external-wss",
      "publish": {
        "topic": "dev/server1/status/request",
        "payload": "GET"
      },
      "state": {
        "topic": "dev/server1/status/response",
        "onValue": "READY"
      }
    }
  ],
  "groups": [
    {
      "id": "living-rooms",
      "name": "Living Room",
      "actions": [
        "lights-on",
        "lights-off",
        "Previous View",
        "Next View",
        "Focus Panel 1 Second",
        "fan-on"
      ]
    },
    {
      "id": "front-door",
      "name": "Front Door",
      "actions": [
        "unlock-door",
        "lock-door",
        "server-1-ping"
      ]
    }
  ]
}