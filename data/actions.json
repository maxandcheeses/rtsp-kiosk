{
  "mqtt": {
    "servers": [
      { "id": "home", "broker": "ws://localhost:9001", "username": "", "password": "" }
    ]
  },
  "actions": [
    {
      "id": "lights-on",
      "type": "mqtt",
      "mqttServer": "home",
      "label": "Lights On",
      "icon": "mdi:lightbulb",
      "publish": {
        "topic": "home/living/lights/set",
        "payload": "ON"
      },
      "state": {
        "topic": "home/living/lights/state",
        "onValue": "ON"
      }
    },
    {
      "id": "lights-off",
      "type": "mqtt",
      "mqttServer": "home",
      "label": "Lights Off",
      "icon": "mdi:lightbulb-off",
      "publish": {
        "topic": "home/living/lights/set",
        "payload": "OFF"
      },
      "state": {
        "topic": "home/living/lights/state",
        "onValue": "OFF"
      }
    },
    {
      "id": "fan-on",
      "type": "mqtt",
      "mqttServer": "home",
      "label": "Fan On",
      "icon": "mdi:fan",
      "publish": {
        "topic": "home/living/fan/set",
        "payload": "ON"
      },
      "state": {
        "topic": "home/living/fan/state",
        "onValue": "ON"
      }
    },
    {
      "id": "fan-off",
      "type": "mqtt",
      "mqttServer": "home",
      "label": "Fan Off",
      "icon": "mdi:fan-off",
      "publish": {
        "topic": "home/living/fan/set",
        "payload": "OFF"
      },
      "state": {
        "topic": "home/living/fan/state",
        "onValue": "OFF"
      }
    },
    {
      "id": "lock-door",
      "type": "mqtt",
      "mqttServer": "home",
      "label": "Lock",
      "icon": "mdi:lock",
      "publish": {
        "topic": "home/front-door/lock/set",
        "payload": "LOCK"
      },
      "state": {
        "topic": "home/front-door/lock/state",
        "onValue": "LOCKED"
      }
    },
    {
      "id": "unlock-door",
      "type": "mqtt",
      "mqttServer": "home",
      "label": "Unlock",
      "icon": "mdi:lock-open",
      "publish": {
        "topic": "home/front-door/lock/set",
        "payload": "UNLOCK"
      },
      "state": {
        "topic": "home/front-door/lock/state",
        "onValue": "UNLOCKED"
      }
    }
  ],
  "groups": [
    {
      "id": "living-room",
      "name": "Living Room",
      "actions": ["lights-on", "lights-off", "fan-on", "fan-off"]
    },
    {
      "id": "front-door",
      "name": "Front Door",
      "actions": ["lock-door", "unlock-door"]
    }
  ]
}
