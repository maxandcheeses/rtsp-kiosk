{
  "mqtt": {
    "servers": [
      {
        "id": "home",
        "broker": "ws://localhost:9001",
        "autoConnect": true
      }
    ]
  },
  "actions": [
    {
      "id": "Focus Panel",
      "type": "focus-panel",
      "description": "Focus",
      "icon": "mdi:fullscreen",
      "timeout": 5,
      "trigger": {
        "mqttServer": "home",
        "topic": "home/living/lights/state",
        "payload": "ON"
      },
      "stream": "test-8"
    },
    {
      "id": "lights-on",
      "type": "mqtt",
      "description": "Lights On",
      "icon": "mdi:lightbulb",
      "mqttServer": "home",
      "publish": {
        "topic": "home/living/lights/set",
        "payload": "ON"
      },
      "state": {
        "topic": "home/living/lights/state",
        "onValue": "ON"
      }
    },
    {
      "id": "lights-off",
      "type": "mqtt",
      "description": "Lights Off",
      "icon": "mdi:lightbulb-off",
      "mqttServer": "home",
      "publish": {
        "topic": "home/living/lights/set",
        "payload": "OFF"
      },
      "state": {
        "topic": "home/living/lights/state",
        "onValue": "OFF"
      }
    },
    {
      "id": "fan-on",
      "type": "mqtt",
      "mqttServer": "home",
      "description": "Fan On",
      "icon": "mdi:fan",
      "publish": {
        "topic": "home/living/fan/set",
        "payload": "ON"
      },
      "state": {
        "topic": "home/living/fan/state",
        "onValue": "ON"
      }
    },
    {
      "id": "fan-off",
      "type": "mqtt",
      "mqttServer": "home",
      "description": "Fan Off",
      "icon": "mdi:fan-off",
      "publish": {
        "topic": "home/living/fan/set",
        "payload": "OFF"
      },
      "state": {
        "topic": "home/living/fan/state",
        "onValue": "OFF"
      }
    },
    {
      "id": "lock-door",
      "type": "mqtt",
      "mqttServer": "home",
      "description": "Lock",
      "icon": "mdi:lock",
      "publish": {
        "topic": "home/front-door/lock/set",
        "payload": "LOCK"
      },
      "state": {
        "topic": "home/front-door/lock/state",
        "onValue": "LOCKED"
      }
    },
    {
      "id": "unlock-door",
      "type": "mqtt",
      "mqttServer": "home",
      "description": "Unlock",
      "icon": "mdi:lock-open",
      "publish": {
        "topic": "home/front-door/lock/set",
        "payload": "UNLOCK"
      },
      "state": {
        "topic": "home/front-door/lock/state",
        "onValue": "UNLOCKED"
      }
    }
  ],
  "groups": [
    {
      "id": "living-rooms",
      "name": "Living Room",
      "actions": [
        "lights-on",
        "lights-off",
        "Next View",
        "Previous View",
        "Focus Panel",
        "fan-on"
      ]
    },
    {
      "id": "front-door",
      "name": "Front Door",
      "actions": [
        "lock-door",
        "unlock-door"
      ]
    }
  ]
}